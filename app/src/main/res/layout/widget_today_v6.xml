<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件「今日速览」v5（M28.13 关键信息突出）：
     撤「今 日 焦 点」与日期小字；任务标题上位（21sp 划线主角）+ 今日计数右置；
     超大倒计时 42sp + 番茄行 + 进度条 + 接下来整行。
     铁律：RemoteViews 白名单禁裸 <View> 垫片，间距一律外边距。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fluid_bg">

    <ImageView
        android:id="@+id/widgetFluid0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fluid_0" />
    <ImageView
        android:id="@+id/widgetFluid1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fluid_1"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/widgetFluid2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fluid_2"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/widgetFluid3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fluid_3"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/widgetFluid4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fluid_4"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/widgetFluid5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fluid_5"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

    <!-- 主角行：任务标题（突出）+ 今日计数 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetHeroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_hl_pink"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_bold"
            android:maxLines="1"
            android:paddingLeft="9dp"
            android:paddingTop="1dp"
            android:paddingRight="9dp"
            android:paddingBottom="2dp"
            android:text="任务标题"
            android:textColor="#FF3D3450"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/widgetCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:layout_marginLeft="8dp"
            android:fontFamily="@font/nunito_bold"
            android:text="今日 0/3"
            android:textColor="#FFC0678C"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 状态 + 时间段 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widgetHeroDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:src="@drawable/widget_dot_pink" />

        <TextView
            android:id="@+id/widgetHeroChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:background="@drawable/widget_chip"
            android:fontFamily="@font/nunito_bold"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:paddingBottom="2dp"
            android:text="即将开始"
            android:textColor="#FFC0678C"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widgetHeroTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:fontFamily="@font/nunito_semibold"
            android:text="09:00 – 10:00"
            android:textColor="#FF8A8494"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 超大倒计时 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetHeroBig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo2_extrabold"
            android:letterSpacing="-0.03"
            android:shadowColor="#70FFFFFF"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="12"
            android:text="02:31"
            android:textColor="#FFC0678C"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetHeroBigLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="9dp"
            android:fontFamily="@font/nunito_bold"
            android:letterSpacing="0.25"
            android:text="后 开 始"
            android:textColor="#FF8A8494"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetPomo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_bold"
        android:text="番茄 2 · 余 12:34"
        android:textColor="#FF8E6BB8"
        android:textSize="11sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/widgetBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="7dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <LinearLayout
        android:id="@+id/widgetNextRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetNextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_bold"
            android:letterSpacing="0.2"
            android:text="接 下 来"
            android:textColor="#FFB08CA0"
            android:textSize="9sp" />

        <ImageView
            android:id="@+id/widgetNextDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginLeft="8dp"
            android:src="@drawable/widget_dot_purple" />

        <TextView
            android:id="@+id/widgetNextTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:fontFamily="@font/nunito_bold"
            android:text="11:00"
            android:textColor="#FF7B62C4"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widgetNextLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_semibold"
            android:maxLines="1"
            android:text="新任务"
            android:textColor="#FF3D3450"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widgetNextStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:fontFamily="@font/nunito_semibold"
            android:text="距开始 4 小时"
            android:textColor="#FF8A8494"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/nunito_semibold"
        android:text="今天没有安排 · 点按打开 Pre2do"
        android:textColor="#FF8A8494"
        android:textSize="12sp"
        android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
