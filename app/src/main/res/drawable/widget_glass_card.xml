<?xml version="1.0" encoding="utf-8"?>
<!-- 主角玻璃卡：低不透明度同族淡紫雾 + 上沿镜面高光 + 白色细描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:centerColor="#99FFFFFF"
                android:endColor="#C2FFF9FF" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="1dp"
        android:right="8dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#8CFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
