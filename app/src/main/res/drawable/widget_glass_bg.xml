<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件外壳（M32 · 对齐 App 的 iOS 26 液态玻璃）：
     淡紫流动渐变 + 28dp 大圆角 + 主镜面描边 + 内缘冷青色散细线。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFF6F0FC"
                android:centerColor="#FFEBDFF6"
                android:endColor="#FFF4E9F5" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="28dp" />
            <stroke android:width="1.2dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
    <item
        android:left="1.6dp"
        android:top="1.6dp"
        android:right="1.6dp"
        android:bottom="1.6dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="26dp" />
            <stroke android:width="0.6dp" android:color="#337FE8FF" />
        </shape>
    </item>
</layer-list>
